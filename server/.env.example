# 复制为 .env 后填写，不要提交
PORT=8788
HOST=127.0.0.1
DATA_DIR=./data

# DeepSeek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 前端来源。同域部署时建议填自己的域名，不要用 *
ALLOWED_ORIGIN=https://cijing.example.com

# 邮箱验证码（需要额外配置 Resend，未配置保持 false）
EMAIL_OTP_ENABLED=false

# 首次启动的引导白名单；启动后可在后台「设置」页维护，数据库里的值优先
ADMIN_IDS=
STYLE_WHITELIST=
